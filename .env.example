# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Camera Configuration
CAMERA_DEVICE=0
CAMERA_RESOLUTION_WIDTH=1280
CAMERA_RESOLUTION_HEIGHT=720
CAMERA_FPS=30
DEVICE_NAME=HomeCamera-01
DEVICE_ID=camera-001

# Network Configuration
SERVICE_PORT=8000
SERVICE_TYPE=_camera-stream._tcp

# Database
DB_PATH=./data/aicams.db
DB_TYPE=sqlite

# JWT Configuration
JWT_SECRET=your-very-secure-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# API URLs (used by viewer)
VITE_API_URL=http://localhost:3000
VITE_SIGNALING_URL=ws://localhost:3000

# WebRTC Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVERS=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# AI/ML Configuration (Phase 3)
TF_LITE_MODEL_PATH=./models/person_detection_lite.tflite
CONFIDENCE_THRESHOLD=0.5
FRAME_ANALYSIS_INTERVAL=5

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Optional: Cloud Integration (Phase 4)
CLOUD_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=aicams-storage

# Optional: Email Configuration (Phase 2+)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: Mobile App Push Notifications (Phase 4)
PUSH_NOTIFICATIONS_ENABLED=false
FCM_API_KEY=your-firebase-api-key
