{
  "name": "aicams-server",
  "version": "0.1.0",
  "description": "Signaling and coordination server for AI Cams system",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "nodemon --exec 'npm test'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:init": "node scripts/init-db.js",
    "db:reset": "rm -f data/aicams.db && npm run db:init",
    "db:migrate": "node scripts/migrate-db.js",
    "docker:build": "docker build -t aicams-server .",
    "docker:run": "docker run -p 3000:3000 aicams-server"
  },
  "keywords": [
    "camera",
    "streaming",
    "webrtc",
    "ai",
    "edge",
    "home-safety"
  ],
  "author": "AI Cams Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "socket.io": "^4.7.1",
    "uuid": "^9.0.0",
    "pino": "^8.16.1",
    "pino-http": "^8.5.0",
    "joi": "^17.11.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.51.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
